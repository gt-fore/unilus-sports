# ================================================================
# UNILUS SPORTS HUB - .gitignore
# ================================================================

# Node modules
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables
.env
.env.local
.env.production
backend/.env
frontend/.env

# Build files
build/
dist/
frontend/build/
frontend/dist/

# IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package lock files (optional - can keep or ignore)
# package-lock.json
# yarn.lock

# Testing
coverage/
.nyc_output/

# Temp files
*.tmp
*.temp
.cache/